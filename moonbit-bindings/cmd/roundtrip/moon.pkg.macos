import {
  "moonbitlang/core/buffer",
  "moonbitlang/core/encoding/utf8",
  "nakake/gpui-bindings",
  "nakake/gpui-bindings/app",
}

options(
  "is-main": true,
  link: {
    "native": {
      "cc-flags": "-I../gpui-sys/include",
      "cc-link-flags": "-L@RUST_LIB_DIR@ -lgpui_sys @NATIVE_LIBS@",
    },
  },
)
